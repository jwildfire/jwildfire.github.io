{
  "manifest_version": 3,
  "name": "Wildfiring Quick Hit",
  "version": "0.2.0",
  "description": "Share the page you're on as a quick hit on the Wildfiring blog, or add it to a Reminders list.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Share as a quick hit",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Open the quick hit popup"
    }
  }
}
